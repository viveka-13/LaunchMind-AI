# ==================================================
# AutoStartup AI — Environment Configuration
# ==================================================

# Get your FREE API key from: https://console.groq.com
GROQ_API_KEY=your_api_key_here

# Optional: Change this to any port you want
PORT=8000

# Get your FREE Pexels API key from: https://www.pexels.com/api/
# Required for auto-embedding relevant images in generated documents (PDF, Word, PPT)
PEXELS_API_KEY=your_pexels_api_key_here

# Optional APIs for advanced validation nodes
CRUNCHBASE_API_KEY=your_crunchbase_api_key_here
GOOGLE_TRENDS_API_KEY=your_google_trends_api_key_here
REDDIT_API_KEY=your_reddit_api_key_here

# Voice Narration (TTS) — generates audio pitch narration
# Default provider is "edge" (free, no API key needed)
# Set to "openai" if you want OpenAI TTS (requires OPENAI_API_KEY)
TTS_PROVIDER=edge
# OPENAI_API_KEY=your_openai_api_key_here

