# ==================================================
# LaunchMind-AI — Environment Configuration
# ==================================================

# --------------------------------------------------
# 1. Primary LLM Provider (Groq) — REQUIRED
# --------------------------------------------------
# Get your FREE API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b  # Default high-performance reasoning model on Groq

# --------------------------------------------------
# 2. Secondary / Fallback LLM Provider (Anthropic) — OPTIONAL
# --------------------------------------------------
# Set this if you want an automated fallback when Groq hits rate limits
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_FALLBACK_PROVIDER=anthropic

# Advanced LLM Resilience & Retry Settings (Defaults shown)
# LLM_MAX_ATTEMPTS=4
# LLM_TIMEOUT_SECONDS=120.0
# LLM_BACKOFF_BASE_SECONDS=1.0
# LLM_BACKOFF_MAX_SECONDS=30.0
# LLM_CIRCUIT_BREAKER_THRESHOLD=5

# --------------------------------------------------
# 3. Server & Storage Configuration
# --------------------------------------------------
PORT=8000
AGENT_TIMEOUT_SECONDS=600
DB_PATH=./data/startup_history.db

# --------------------------------------------------
# 4. Presentation Imagery (Pexels) — RECOMMENDED
# --------------------------------------------------
# Get your FREE Pexels API key from: https://www.pexels.com/api/
# Used to auto-embed relevant photography into PPT pitch decks, PDFs, and Word docs
PEXELS_API_KEY=your_pexels_api_key_here

# --------------------------------------------------
# 5. Pitch Narration & Audio (TTS)
# --------------------------------------------------
# Default provider is "edge" (free Microsoft Edge Neural TTS, no API key needed)
# Set to "openai" if you want OpenAI TTS (requires OPENAI_API_KEY)
TTS_PROVIDER=edge
# OPENAI_API_KEY=your_openai_api_key_here

# --------------------------------------------------
# 6. Deep Research & Market Data APIs — OPTIONAL
# --------------------------------------------------
# SEC EDGAR Financial Intelligence (Requires an identity user-agent per SEC guidelines)
SEC_USER_AGENT=LaunchMindAI/1.0 (contact@launchmind.ai)

# Crunchbase API for startup funding data
CRUNCHBASE_API_KEY=your_crunchbase_api_key_here

# Reddit API for customer voice & sentiment analysis
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=LaunchMindAI/1.0 by AutoStartup

# --------------------------------------------------
# 7. Cloud Document Exporters — OPTIONAL
# --------------------------------------------------
# Notion Workspace Export
NOTION_API_KEY=secret_your_notion_api_key_here
NOTION_PARENT_PAGE_ID=your_notion_parent_page_id_here

# Google Workspace Export (Docs & Slides)
# Provide either a path to service account JSON, or standard ADC credentials
# GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google_service_account.json
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/google_service_account.json
# GOOGLE_OAUTH_TOKEN_PATH=./credentials/token.json
# GOOGLE_SHARE_EMAIL=founder@yourstartup.com
